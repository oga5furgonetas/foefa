<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FDS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/papel_noche</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FDS.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/papel_noche</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/arranque</item>
        <item name="postSplashScreenTheme">@style/Theme.FDS</item>
    </style>
</resources>

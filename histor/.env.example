# ════════════════════════════════════════════════════════════════════════
#  Histor — variables de entorno
#  Copia este archivo a `.env` (no se sube a git) y rellena lo que tengas.
#  Nada de lo que aparece aquí es un secreto real: son ejemplos o están vacíos.
#
#  Leyenda:  [OBLIGATORIA]            sin ella no arranca en producción
#            [RECOMENDADA]            funciona sin ella, pero con límites
#            [OPCIONAL]               activa una integración concreta
#  Sin claves externas Histor arranca en local/DEMO y cada integración
#  ausente se DESACTIVA de forma explícita (nunca se simula).
# ════════════════════════════════════════════════════════════════════════

# ── Núcleo ───────────────────────────────────────────────────────────────

# [OBLIGATORIA] development | test | production. `next start` fija production.
NODE_ENV=development

# [OBLIGATORIA] PostgreSQL 15+ (extensión pg_trgm; la crea la migración).
# Dónde: tu Postgres gestionado (Neon, Supabase, RDS, Fly Postgres…) o local:
#   docker compose up -d db   →   postgres://histor:histor@localhost:5432/histor_dev
DATABASE_URL=postgres://histor:histor@localhost:5432/histor_dev

# [OPCIONAL] Conexiones máximas del pool por proceso (web y worker). Por defecto 10.
DATABASE_POOL_MAX=10

# [OPCIONAL] Redis para el límite de ritmo compartido entre varias réplicas web.
# Sin él, el límite es en memoria (correcto con una sola réplica). Ej.: redis://localhost:6379
REDIS_URL=

# [OBLIGATORIA en producción] URL pública de la web, sin barra final.
# Se usa en canónicas, sitemaps, correos, OAuth y Stripe. Ej.: https://histor.news
PUBLIC_BASE_URL=http://localhost:3000

# [OBLIGATORIA en producción] Secretos para firmar cookies y tokens (≥32 caracteres).
# Varios separados por comas para ROTAR: el primero firma, todos verifican.
# Genera uno con:  openssl rand -base64 48
SESSION_SECRETS=

# [OBLIGATORIA en producción] Clave para cifrar datos sensibles en la base (secretos 2FA). ≥32 caracteres.
# Genera con: openssl rand -base64 48 · Si la cambias, los 2FA existentes dejan de valer (hay que reactivarlos).
DATA_ENCRYPTION_KEY=

# [OBLIGATORIA en producción] Sal para seudonimizar identificadores de analítica (nunca se guarda la IP).
# Genera con: openssl rand -hex 16
ANALYTICS_SALT=

# [OPCIONAL] 1 = modo DEMO: la web muestra SOLO el contenido ficticio marcado DEMO, con aviso,
# sin indexar (robots Disallow) y sin publicar en redes ni enviar alertas. Nunca en producción.
DEMO_MODE=0

# [RECOMENDADA en producción] 1 = el worker lee las fuentes reales. 0 = no sale a la red
# (verificación y vigilancia siguen funcionando con lo que ya hay).
INGEST_ENABLED=0

# [OPCIONAL] Segundos entre vueltas del pipeline del worker (mínimo 15). Por defecto 60.
PIPELINE_INTERVAL_SEC=60

# [OPCIONAL] Puerto de salud del worker (GET /health). Por defecto 8081.
WORKER_HEALTH_PORT=8081

# [OPCIONAL] URL de contacto que se envía en el User-Agent del rastreador (buena práctica con los editores).
# Por defecto: la página «Cómo funciona». Ej.: https://histor.news/en/how-it-works
BOT_CONTACT_URL=

# ── Administración ───────────────────────────────────────────────────────

# [RECOMENDADA] Primer administrador. Se crea con:  npm run cli -w @histor/worker -- create-admin
# La contraseña debe tener ≥12 caracteres. Tras crearlo, puedes borrar ADMIN_PASSWORD del entorno.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# [OPCIONAL] 1 = editores y administradores deben usar 2FA (TOTP). Por defecto: sí en producción.
ADMIN_REQUIRE_2FA=

# [OPCIONAL] IPs o rangos IPv4 CIDR que pueden usar el panel, separados por comas. Vacío = sin restricción.
# Ej.: 203.0.113.10,198.51.100.0/24
ADMIN_IP_ALLOWLIST=

# ── Datos legales del titular (NO se inventan: si faltan, se muestra [PENDIENTE]) ──

# [OBLIGATORIA antes de lanzar] Aparecen en Aviso legal / Impressum, privacidad y condiciones.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_TAX_ID=
LEGAL_REGISTRY=
LEGAL_REPRESENTATIVE=
# Responsable editorial (en Alemania, «Verantwortlich i. S. d. § 18 Abs. 2 MStV»).
LEGAL_EDITOR_IN_CHARGE=
# Correo del delegado de protección de datos (si no hay, se usa CONTACT_EMAIL).
DPO_EMAIL=
# [RECOMENDADA] Correo de contacto público.
CONTACT_EMAIL=

# ── IA (toda opcional: sin ella, Histor redacta con plantillas deterministas) ──
# Formato «proveedor:modelo». Proveedores: anthropic | openai (o compatible) | gemini.
# La IA SOLO redacta a partir de la ficha de hechos verificados; un validador comprueba
# cada frase (nombres, cifras, fechas, citas) y descarta el texto si algo no cuadra.

# [OPCIONAL] Modelo para redactar. Ej.: anthropic:claude-opus-5
AI_PROVIDER_WRITING=
# [OPCIONAL] Modelo para adaptar a otros idiomas (por defecto, el de redacción).
AI_PROVIDER_TRANSLATION=
# [OPCIONAL] Modelo para extracción auxiliar (por defecto, el de redacción).
AI_PROVIDER_EXTRACTION=
# [RECOMENDADA si usas IA] Tope de gasto mensual en USD. 0 = sin tope. Al alcanzarlo, se vuelve a plantillas.
AI_MONTHLY_BUDGET_USD=0
# [OPCIONAL] Precios por millón de tokens para modelos no incluidos: {"modelo":{"input":1,"output":5}}
AI_PRICE_OVERRIDES=
# [RECOMENDADA con un plan gratuito] Tokens por modelo en 24 h; al llegar, plantillas hasta que se libere.
# Groq gratis (sept. 2026): openai/gpt-oss-120b y gpt-oss-20b, 200.000 tokens/día cada uno → 180000.
# Ej. Groq (lista = respaldo cuando un modelo agota su cupo): AI_PROVIDER_WRITING=openai:openai/gpt-oss-120b,openai:qwen/qwen3.8-27b
#   AI_PROVIDER_TRANSLATION=openai:openai/gpt-oss-20b,openai:qwen/qwen3.8-27b
#           OPENAI_BASE_URL=https://api.groq.com/openai/v1  (clave en https://console.groq.com/keys)
AI_DAILY_TOKEN_LIMIT=0
# [OPCIONAL] Importancia mínima (0-1) de una historia para gastar IA en ella. 0 = todas.
AI_MIN_IMPORTANCE=0
# [OPCIONAL] Modelos con razonamiento (gpt-oss, o-series): low | medium | high. «low» gasta menos cupo.
AI_REASONING_EFFORT=
# [OPCIONAL] Zona horaria en la que el proveedor renueva el cupo diario (Groq y Gemini: America/Los_Angeles).
AI_QUOTA_RESET_TZ=America/Los_Angeles
# [OPCIONAL] Idiomas a los que traduce la IA (con un cupo gratuito, p. ej. es,en). Vacío = todos.
AI_TRANSLATE_TO=

# Dónde: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Dónde: https://platform.openai.com/api-keys (o la de un proveedor compatible con OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Dónde: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Pagos (Stripe) ───────────────────────────────────────────────────────
# Sin STRIPE_SECRET_KEY la web lo dice («las suscripciones todavía no están activas») y no cobra.
# Histor nunca ve ni guarda datos de tarjeta: todo pasa por Stripe Checkout y el portal de cliente.

# [OPCIONAL] Dónde: https://dashboard.stripe.com/apikeys  (sk_live_… o sk_test_…)
STRIPE_SECRET_KEY=
# [OBLIGATORIA si hay Stripe] Dónde: Stripe → Developers → Webhooks → endpoint
#   https://TU-DOMINIO/api/v1/stripe/webhook  con los eventos:
#   checkout.session.completed, customer.subscription.created/updated/deleted,
#   invoice.paid, invoice.payment_failed   → «Signing secret» (whsec_…)
STRIPE_WEBHOOK_SECRET=
# [OPCIONAL] 1 = impuestos con Stripe Tax (actívalo antes en el panel de Stripe y registra tus jurisdicciones).
STRIPE_AUTOMATIC_TAX=0

# ── Correo ───────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los correos (verificación, recuperación, newsletters) quedan en la
# tabla mail_outbox con estado «logged» y NO se envían (se ven en el panel → Operación).

# [RECOMENDADA] Remitente verificado en tu proveedor. Ej.: Histor <no-reply@histor.news>
EMAIL_FROM=Histor <no-reply@localhost>
# [RECOMENDADA] Dónde: https://resend.com/api-keys (verifica tu dominio con SPF/DKIM)
RESEND_API_KEY=

# ── Avisos push (Web Push, VAPID) ────────────────────────────────────────
# [OPCIONAL] Genera el par con:  npx web-push generate-vapid-keys
# Sin ellas, las alertas se calculan y registran como «dry_run» pero no se envían.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto obligatorio para los servicios push. Ej.: mailto:ops@histor.news
VAPID_SUBJECT=

# ── Inicio de sesión con Google / Apple (OIDC) ───────────────────────────
# [OPCIONAL] Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web)
#   Redirect URI autorizada: https://TU-DOMINIO/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [OPCIONAL] Apple: https://developer.apple.com → Certificates, IDs & Profiles → Services ID + Key (Sign in with Apple)
#   Return URL: https://TU-DOMINIO/api/v1/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del .p8 (con \n escapados si tu plataforma no admite varias líneas)
APPLE_PRIVATE_KEY=

# ── Fuentes con API autorizada (opcionales; vienen en pausa) ─────────────
# Las redes sociales son PISTAS, nunca prueba: activan una investigación, no una noticia.
# Reddit: https://www.reddit.com/prefs/apps (script app) — respeta sus Data API Terms.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X: https://developer.x.com (plan de pago para lectura)
X_BEARER_TOKEN=
# YouTube Data API: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ── Publicación en redes (solo noticias verificadas, nunca DEMO ni «en desarrollo») ──
# Además hay que activar «Publicar en redes automáticamente» en el panel → Umbrales.
# Bluesky: Settings → App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon: Preferencias → Desarrollo → Nueva aplicación (permiso write:statuses)
MASTODON_BASE_URL=
MASTODON_TOKEN=
# X: token de usuario OAuth 2.0 con tweet.write
X_USER_ACCESS_TOKEN=

# ── Buscadores ───────────────────────────────────────────────────────────
# [RECOMENDADA] IndexNow: avisa al momento a Bing, Yahoo, DuckDuckGo, Yandex… de cada noticia.
# Sin cuenta: basta una clave aleatoria (8-128 caracteres [a-zA-Z0-9-]), servida en /indexnow-key.txt.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
# Código de verificación de Google Search Console (etiqueta HTML, solo el valor de content="…")
GOOGLE_SITE_VERIFICATION=
# Código de verificación de Bing Webmaster Tools (msvalidate.01)
BING_SITE_VERIFICATION=
# País del lector por IP (DB-IP Country Lite, CC BY 4.0): la imagen Docker la descarga al construir.
# En local: node scripts/fetch-geoip.mjs  (sin ella, el país sale del idioma del navegador)
GEOIP_DB_PATH=

# ── Observabilidad ───────────────────────────────────────────────────────
# [RECOMENDADA] Dónde: https://sentry.io → proyecto Node → Client Keys (DSN)
SENTRY_DSN=
# [RECOMENDADA] Protege GET /api/metrics (Prometheus): Authorization: Bearer <token>. Sin él, desactivado.
METRICS_TOKEN=
# trace | debug | info | warn | error
LOG_LEVEL=info
# Nombre del servicio en los logs (web / worker)
HISTOR_SERVICE=histor

# ── Copias de seguridad en almacenamiento S3 compatible ──────────────────
# [RECOMENDADA en producción] Destino de `infra/backup.sh` (Cloudflare R2, AWS S3, Backblaze B2, MinIO…).
# Sin ellas, la copia queda solo en el disco local (backups/).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Solo desarrollo y pruebas ────────────────────────────────────────────
# Servidor local de feeds DEMO (npm run fixtures -w @histor/worker)
DEMO_FEED_BASE=http://127.0.0.1:4545
FIXTURES_PORT=4545
DEMO_PHASE=1
# Bases de pruebas (se BORRAN en cada ejecución: deben terminar en _test / _e2e)
TEST_DATABASE_URL=postgres://histor:histor@localhost:5432/histor_test
WORKER_TEST_DATABASE_URL=postgres://histor:histor@localhost:5432/histor_worker_test
E2E_DATABASE_URL=postgres://histor:histor@localhost:5432/histor_e2e
